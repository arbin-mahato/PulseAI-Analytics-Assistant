{
  "name": "tradelab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "chat:web": "next dev",
    "chat:cli": "node --import tsx agent/tradelab_agent_cli.ts",
    "cli": "node --import tsx agent/tradelab_agent_cli.ts",
    "lint": "eslint",
    "build-db": "node script/build_db.js",
    "populate-sample-data": "node script/populate_sample_data.js",
    "postinstall": "mkdir -p public/pdfjs && cp ./node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdfjs/pdf.worker.min.js || echo 'pdf.worker copy skipped'",
    "setup": "node script/setup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:python",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:python": "node script/test-python.mjs",
    "test:live": "node --import tsx script/live-smoke.ts",
    "seed:clickhouse": "node script/populate_clickhouse_data.js"
  },
  "dependencies": {
    "@clickhouse/client": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.6.1",
    "next": "^16.3.4",
    "pdfjs-dist": "5.4.296",
    "pino": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^9.0.1",
    "react-pdf": "^10.2.0",
    "remark-gfm": "^4.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
