  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "chat:web": "next dev --webpack",
    "chat:cli": "npx tsx agent/tradelab_agent_cli.ts",
    "cli": "npx tsx agent/tradelab_agent_cli.ts",
    "lint": "eslint",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "build-db": "node script/build_db.js",
    "cleanup-db": "bash script/cleanup_duckdb.sh",
