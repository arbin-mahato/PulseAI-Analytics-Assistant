    "@clickhouse/client": "^1.13.0",
    "@google-cloud/storage": "^7.17.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.2",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^16.6.1",
    "duckdb": "^1.4.2",
    "multer": "^2.0.2",
    "next": "16.0.1",
    "next-auth": "^4.24.12",
    "nodemailer": "^7.0.10",
    "pdfjs-dist": "5.4.296",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^5.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^9.0.1",
    "react-pdf": "^10.2.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/multer": "^2.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.11.1",
    "eslint": "^9",
