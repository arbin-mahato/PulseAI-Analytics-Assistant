# Add one or more keys. Never use NEXT_PUBLIC_ for these values.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
LLM_FALLBACK_ORDER=claude,groq,gemini
GROQ_MODEL=qwen/qwen3.8-27b
# Default Qwen output budget fits the tested free-tier limits.
GROQ_MAX_OUTPUT_TOKENS=768
GEMINI_MODEL=gemini-3.5-flash-lite
CLAUDE_MODEL=claude-haiku-4-5

# Local DuckDB is the default: no cloud account or ClickHouse required.
ANALYTICS_BACKEND=duckdb
TRADELAB_DATA_DIR=./data
SEED=42
SEED_USERS=100
# Optional fixed snapshot date, otherwise today is used when seeding.
# SEED_AS_OF=2026-09-11
# PYTHON_BIN=/absolute/path/to/.venv/bin/python
# METRIC_STORE_DB_PATH=/absolute/path/to/data/warehouse.duckdb

# Persistence Backend: SQLite is used automatically by default (zero setup).
# To use PostgreSQL for conversations and artifact state (e.g. on Render, Neon, Supabase):
# DATABASE_URL=postgresql://user:password@hostname:5432/tradelab

# Public hosting: choose a strong workspace password. Local development can leave it blank.
APP_ACCESS_PASSWORD=
# Generated and persisted automatically if omitted. Set this for external deployments.
APP_SESSION_SECRET=
# Set to your public URL, e.g. https://tradelab.onrender.com
APP_ORIGIN=
# Only for an intentionally public, disposable demo (any visitor can spend API quota).
ALLOW_PUBLIC_DEMO=false
AGENT_TIMEOUT_MS=360000
MAX_AGENT_TURNS=16

# Optional ClickHouse raw-data backend. Metric tables remain in DuckDB.
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_USER=tradelab
# CLICKHOUSE_PASSWORD=

# Optional Vercel frontend only: point API rewrites at Render.
# TRADELAB_BACKEND_URL=https://your-backend.onrender.com
